# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (never commit raw or processed data)
data/raw/
data/processed/

# Trained model artifacts — anchored to the repo-root models/ dir only, so it
# does NOT also swallow the src/models/ source package (graph_builder's sibling
# GraphSAGE model, tft_model.py, ensemble.py).
/models/

# Runtime logs
logs/

# MLflow local runs
mlruns/

# TensorBoard event logs and periodic training checkpoints (RunLogger,
# src/training/run_logging.py) — regenerated by every training run, not
# committed artifacts. The final model artifacts under models/ (already
# gitignored above) are the ones that matter for reproducibility.
runs/
checkpoints/

# Monitoring runtime output
monitoring/reports/
monitoring/alerts/

# Ensemble probability dumps (scripts/export_test_probabilities.py) — large
# regenerated arrays, must be re-run against the current models/ensemble.json
# before each Phase 9 step, not committed. The small JSON reports
# (reports/phase9_*.json, reports/ensemble_results.json) ARE tracked as the
# durable record.
reports/ensemble_*_probabilities.npz

# Environment / secrets
.env
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Pre-commit
.pre-commit-cache/

.ai/
