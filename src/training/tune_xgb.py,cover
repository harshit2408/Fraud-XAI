> class XGBPruningCallback(xgb.callback.TrainingCallback):
>     """Reports each boosting round's validation metric to an Optuna trial and
>     raises `optuna.TrialPruned` when the trial should be pruned.
  
>     Phase D2 (docs/IMPLEMENTATION_PLAN.md, MEDIUM): `MedianPruner` was
>     configured on the study, but `objective()` never called `trial.report()`
>     / `trial.should_prune()` — pruning was a no-op that gave a false
>     impression compute was being saved. Contrast with train_tft.py, which
>     reports correctly once per epoch (train_tft.py:574-578). This mirrors
>     that pattern once per XGBoost boosting round via the native callback
>     API, rather than epoch-based reporting which doesn't exist for XGBoost.
  
>     Pass via the `XGBClassifier(..., callbacks=[...])` constructor kwarg,
>     not `fit(callbacks=[...])` — the latter is deprecated in xgboost>=2.0
>     and (confirmed by smoke test) behaves identically either way.
>     """
  
>     def __init__(self, trial: optuna.Trial, eval_set_name: str, metric_name: str) -> None:
>         self._trial = trial
>         self._eval_set_name = eval_set_name
>         self._metric_name = metric_name
  
>     def after_iteration(self, model: Any, epoch: int, evals_log: Dict[str, Dict[str, list]]) -> bool:
>         try:
>             score = evals_log[self._eval_set_name][self._metric_name][-1]
>         except KeyError as exc:
>             observed = {name: list(metrics) for name, metrics in evals_log.items()}
>             raise KeyError(
>                 f"XGBPruningCallback: eval set {self._eval_set_name!r} / metric "
>                 f"{self._metric_name!r} not found in evals_log (observed: {observed}). "
>                 "Check eval_set ordering and eval_metric."
>             ) from exc
  
>         self._trial.report(score, epoch)
>         if self._trial.should_prune():
>             raise optuna.TrialPruned(f"Trial pruned at boosting round {epoch}.")
  
>         return False  # False = continue training
  
  
> def build_sampler(seed: int) -> optuna.samplers.TPESampler:
>     """Seeded TPE sampler factory (Phase D2).
  
>     Extracted to a standalone function so the reproducibility property —
>     `build_sampler(seed)` used in two independent studies over the same
>     search space and objective yields identical trial trajectories — is
>     unit-testable without running real XGBoost training or needing parquet
>     data on disk.
>     """
>     return optuna.samplers.TPESampler(seed=seed)
  
  
> def build_tuned_params_document(
>     run_id: str,
>     best_params: Dict[str, Any],
>     best_value: float,
>     seed: int,
>     n_trials: int,
> ) -> Dict[str, Any]:
>     """Assemble the versioned tuned-params document (Phase D3).
  
>     Kept separate from `write_tuned_params` so its shape is unit-testable
>     without touching the filesystem.
>     """
>     return {
>         "mlflow_run_id": run_id,
>         "created_at": datetime.now(timezone.utc).isoformat(),
>         "random_seed": seed,
>         "n_trials": n_trials,
>         "best_value": best_value,
>         "params": best_params,
>     }
  
  
> def write_tuned_params(
>     tuned_dir: Path,
>     run_id: str,
>     study: "optuna.Study",
>     seed: int,
>     n_trials: int,
> ) -> Path:
>     """Write the winning trial's params to `<tuned_dir>/xgb_<run_id>.yaml`.
  
>     Phase D3 (docs/IMPLEMENTATION_PLAN.md, HIGH finding L204-219): replaces
>     the old "manually update config.yaml with these parameters" log
>     instruction, which had no run ID or provenance link — the shipped
>     config could not be traced to any actual tuning experiment. Training
>     scripts read this file by reference via `--tuned-params` instead of a
>     human re-typing numbers.
>     """
>     document = build_tuned_params_document(
>         run_id, study.best_params, study.best_value, seed, n_trials
>     )
  
>     tuned_dir.mkdir(parents=True, exist_ok=True)
>     path = tuned_dir / f"xgb_{run_id}.yaml"
  
>     header = (
>         f"# Generated by src/training/tune_xgb.py — Optuna study {study.study_name!r}\n"
>         f"# mlflow_run_id: {run_id}\n"
>         "# Do not hand-edit; re-run tuning to produce a new file.\n"
>     )
>     with open(path, "w", encoding="utf-8") as f:
>         f.write(header)
>         yaml.safe_dump(document, f, default_flow_style=False, sort_keys=False)
  
>     return path
  
  
